{
  "name": "soulforge",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "preview": "vite preview",
    "dev:emulator": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-soulforge",
    "test:backend": "node tests/emulator/rules.mjs && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cWeninger1/Soulforge.git"
  },
  "bugs": {
    "url": "https://github.com/cWeninger1/Soulforge/issues"
  },
  "homepage": "https://github.com/cWeninger1/Soulforge#readme",
  "type": "module",
  "private": true,
  "dependencies": {
    "@babylonjs/core": "9.33.2",
    "firebase": "12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.14.7"
  }
}
