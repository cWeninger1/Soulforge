rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // One private atomic snapshot per account. Payload contents are client-trusted RPG progress.
  match /users/{uid}/characters/first {
   function owner(){return request.auth != null && request.auth.uid == uid;}
   function valid(){let d=request.resource.data;return d.keys().hasOnly(['version','revision','payload']) && d.version == 1 && d.revision is int && d.revision > 0 && d.payload is string && d.payload.size() > 0 && d.payload.size() <= 96000;}
   allow get, delete: if owner();
   allow create: if owner() && valid() && request.resource.data.revision == 1;
   allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
  }
 }
}
